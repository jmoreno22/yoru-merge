{
  "mcpServers": {
    "angular-cli": {
      "type": "stdio",
      "command": "node",
      "args": ["node_modules/@angular/cli/bin/ng.js", "mcp", "--read-only"]
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "Authorization": "${CONTEXT7_API_KEY:-}"
      }
    }
  }
}
