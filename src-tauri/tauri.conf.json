{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YoruMerge",
  "version": "1.0.5",
  "identifier": "com.jhoan.yorumerge",
  "build": {
    "beforeDevCommand": "pnpm start",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist/yoru-merge/browser"
  },
  "app": {
    "windows": [
      {
        "title": "YoruMerge",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "visible": false,
        "backgroundColor": "#050712",
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Jhoan",
    "copyright": "Copyright \u00a9 2026 Jhoan",
    "category": "DeveloperTool",
    "shortDescription": "A fast, beautiful Git GUI desktop client",
    "longDescription": "YoruMerge is a cross-platform Git GUI built with Tauri, Angular, and Rust. Features branch visualization, staging, conflict resolution, and more.",
    "windows": {
      "digestAlgorithm": "sha256",
      "certificateThumbprint": null,
      "timestampUrl": "",
      "tsp": false,
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "git"
        ]
      },
      "rpm": {
        "depends": [
          "git"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVCMjc3RjNFMjhEMUQzRjMKUldUejA5RW9QbjhuNjc0Z1lRaHh5QTFXMEVrTTBjS2hzM3l3NmdxZGFGK3lTOWUvaGx3T1FFZkoK",
      "endpoints": [
        "https://github.com/jmoreno22/yoru-merge/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
